# =============================================================================
# lumina-inference .gitattributes
# =============================================================================
# Enforce LF line endings for all text files in the repository.
# This ensures consistent line endings across Windows, macOS, and Linux.

# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Explicitly mark known text file types
*.py        text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.rst       text eol=lf
*.csv       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.xml       text eol=lf
*.in        text eol=lf
*.lock      text eol=lf

# Docker files
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Git config files
.gitignore     text eol=lf
.gitattributes text eol=lf
.dockerignore  text eol=lf
.editorconfig  text eol=lf

# License
LICENSE     text eol=lf

# Makefile (tabs required, but still LF)
Makefile    text eol=lf

# Binary files — do not normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       binary
*.pt        binary
*.pth       binary
*.ckpt      binary
*.safetensors binary
*.tar.gz    binary
*.zip       binary
*.whl       binary
*.pdf       binary
